{
  "provider_options": {
    "field_hints": {
      "api_key": "仅保存在 .env；更新后需重启后端生效",
      "endpoint": "非敏感运行配置，保存后立即生效",
      "model": "当前 provider 实际调用的模型",
      "thinking": "控制模型是否启用深度思考",
      "extra_headers": "JSON 对象，将随 provider 请求发送"
    },
    "settings": {
      "embedding": {
        "label": "Embedding",
        "description": "检索与素材匹配使用的向量服务",
        "fields": [
          {
            "name": "api_key",
            "label": "API Key",
            "kind": "text",
            "secret": true,
            "env_var": "EMBEDDING_API_KEY"
          },
          {
            "name": "endpoint",
            "label": "Endpoint",
            "kind": "text",
            "hint": "留空时仅兼容回退 EMBEDDING_API_URL 环境变量"
          },
          {
            "name": "model",
            "label": "嵌入模型",
            "kind": "text"
          }
        ]
      },
      "media": {
        "label": "媒体工具",
        "description": "视频探测与渲染使用的本地可执行文件",
        "fields": [
          {
            "name": "ffmpeg_path",
            "label": "FFmpeg 路径",
            "kind": "text"
          },
          {
            "name": "ffprobe_path",
            "label": "FFprobe 路径",
            "kind": "text"
          }
        ]
      },
      "asset_library": {
        "label": "素材分类",
        "description": "AI 分类建议使用的模型与采样数量",
        "fields": [
          {
            "name": "category_suggestion_model",
            "label": "分类建议模型",
            "kind": "text"
          },
          {
            "name": "category_suggestion_sample_size",
            "label": "采样数量",
            "kind": "number",
            "integer": true,
            "min": 1,
            "max": 500,
            "step": 1
          }
        ]
      },
      "scene": {
        "label": "场景导入",
        "description": "Import 模式的场景素材目录与默认转场",
        "fields": [
          {
            "name": "folders",
            "label": "场景目录",
            "kind": "json",
            "json_type": "array",
            "item_type": "object",
            "required_item_keys": [
              "path"
            ],
            "hint": "JSON 数组，每项包含 name 与相对 workspace 的 path"
          },
          {
            "name": "transition_duration_ms",
            "label": "转场时长（毫秒）",
            "kind": "number",
            "integer": true,
            "min": 0,
            "max": 10000,
            "step": 50
          }
        ]
      }
    },
